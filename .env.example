FIGMA_PERSONAL_TOKEN=your_figma_personal_access_token_here
FIGMA_FILE_KEY=your_figma_file_key_here

# Powers /api/damian-llm (the "Chat with me" card). Uses Claude Haiku 4.5.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Powers /api/now-playing (public, read-only Spotify widget).
# Client ID + Secret come from your Spotify Developer Dashboard app.
# Refresh token is obtained once via a personal OAuth login (see setup notes).
# Never share SPOTIFY_CLIENT_SECRET or SPOTIFY_REFRESH_TOKEN — either one
# grants read access to your Spotify playback state indefinitely.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Powers /api/letterboxd and the "Recently watched" movie shelf.
# This is public RSS data, so it only needs your Letterboxd username.
LETTERBOXD_USERNAME=your_letterboxd_username_here
